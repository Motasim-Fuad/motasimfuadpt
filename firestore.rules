rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    match /projects/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /skills/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /blogs/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /meta/{id} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Public contact form: visitors are not logged in.
    match /contacts/{id} {
      allow create: if true;
      allow read, update, delete: if isSignedIn();
    }
  }
}
